{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch NetSniffer",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/NetSniffer.App/bin/Debug/net8.0-windows/NetSniffer.App.dll",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ]
}

