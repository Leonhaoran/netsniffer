{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "NetSniffer.sln", "--configuration", "Debug"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "NetSniffer.sln", "--configuration", "Debug"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "run",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "src/NetSniffer.App/NetSniffer.App.csproj"],
      "problemMatcher": "$msCompile"
    }
  ]
}

